# ============================================
# Environment Variables Template
# ============================================
# این فایل رو کپی کن به .env و مقادیر واقعی رو پر کن.
# فایل .env تو .gitignore هست و push نمی‌شه.
# ============================================

# ===== Google Gemini API =====
# از https://aistudio.google.com/app/apikey دریافت کن
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Atria ASI API =====
# از https://api.atria-asi.ai دریافت کن
ATRIA_API_KEY=your_atria_api_key_here

# ===== Firebase AppCheck Debug Token (اختیاری) =====
# فقط برای تست Firebase در حالت Debug. در production خالی بذار.
FIREBASE_APPCHECK_DEBUG_TOKEN=